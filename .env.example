# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/jhariya?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_jwt_super_secret_key_change_me_in_production
JWT_EXPIRE=7d

# Razorpay Payment Gateway
RAZORPAY_KEY=rzp_test_your_razorpay_key_id
RAZORPAY_SECRET=your_razorpay_secret_key
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email service (SMTP)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password_for_email
EMAIL_FROM=Jhariya E-Commerce <noreply@jhariya.com>
